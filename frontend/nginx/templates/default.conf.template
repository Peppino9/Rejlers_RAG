server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_pass ${NGINX_BACKEND}/api/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
