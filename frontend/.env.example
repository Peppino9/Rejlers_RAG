# Optional. Leave unset during local dev: the app calls /api/... on the Vite server and
# vite.config.js proxies to FastAPI — works from your phone at http://<your-LAN-IP>:5173
# VITE_API_BASE_URL=http://localhost:8000
#
# Use a full URL when the built site talks to an API on another origin (e.g. production).
# Railway (Docker frontend): VITE_API_BASE_URL is used by nginx to proxy /api (see nginx/templates/).
# Use https (not http) for the API host so TLS to the backend works.
# VITE_API_BASE_URL=https://your-backend.up.railway.app
